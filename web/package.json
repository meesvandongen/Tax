{
  "name": "taxcity-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "cd .. && cargo build --release --target wasm32-unknown-unknown -p sim-wasm && mkdir -p web/public && cp target/wasm32-unknown-unknown/release/sim_wasm.wasm web/public/sim.wasm",
    "dev": "pnpm run wasm && vp dev",
    "build": "pnpm run wasm && tsc --noEmit && vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "lint": "vp lint"
  },
  "dependencies": {
    "three": "^0.186.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright-core": "^1.56.1",
    "typescript": "5.9",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.28.8+sha512.f6988a32046b9a3f78d7d7ee0747926bbe905ff9dff73bf19abb87bd7d1906a2ac90d93f73be32b5f9e14c2899569bcb0c9c5ec8a19e083f5d71bbab6dd9e0b8"
}
