{
  "name": "taxcity-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "cd .. && cargo build --release --target wasm32-unknown-unknown -p sim-wasm && mkdir -p web/public && cp target/wasm32-unknown-unknown/release/sim_wasm.wasm web/public/sim.wasm",
    "dev": "pnpm run wasm && vp dev",
    "build": "pnpm run wasm && tsc --noEmit && vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "lint": "vp lint"
  },
  "dependencies": {
    "three": "^0.186.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright-core": "^1.64.1",
    "typescript": "5.9",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
