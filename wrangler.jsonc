{
  // Static-assets-only Worker serving the built web app (no Worker script).
  // Build with `bash scripts/build-web.sh`, deploy with `npx wrangler deploy`.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "tax",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./web/dist"
  }
}
